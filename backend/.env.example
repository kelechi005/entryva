NODE_ENV=development
PORT=4000

# Structured logging (pino). One JSON object per log line in production;
# pretty-printed to the terminal automatically when NODE_ENV != production.
# Standard pino levels: fatal, error, warn, info, debug, trace.
LOG_LEVEL=info

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/estate_visitor?schema=public

AUTH_SECRET=replace-with-a-long-random-value
AUTH_REFRESH_SECRET=replace-with-a-different-long-random-value
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=7d

CORS_ORIGINS=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000
TRUST_PROXY=false

# Object storage (for visitor/resident photos, if introduced)
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Outbound transactional email (resident invite links, etc.) via Resend
# (https://resend.com) — chosen for cost: 3,000 emails/month free, then
# $20/mo for 50k, no minimum, no SMTP setup. Get RESEND_API_KEY from
# https://resend.com/api-keys after verifying a sending domain there
# (Resend requires domain verification via DNS records before you can
# send from your own address — takes a few minutes, not optional).
# EMAIL_FROM must be an address on that verified domain, e.g.
# "Estate Visitor Platform <no-reply@yourdomain.com>".
#
# COMMON TRAP: Resend's dashboard "send a test email" snippet uses
# EMAIL_FROM=onboarding@resend.dev, which is Resend's own sandbox
# sender. It works when you test it there because Resend only lets a
# sandbox sender deliver to the account owner's own inbox — it will
# 403 on every real resident's email address. Verify your own domain
# (Domains tab) and use an address on it, or every invite past your own
# test email will silently fail exactly like this.
#
# Leave RESEND_API_KEY blank to keep the current dev behavior (logs the
# email instead of sending it) — nothing else needs to change locally.
RESEND_API_KEY=
EMAIL_FROM=

# TURN relay for officer-to-officer calls — see coturn/README.md for the
# full deployment steps. TURN_SECRET must exactly match
# static-auth-secret in coturn/turnserver.conf; RealtimeService uses it
# to mint short-lived (1h) credentials per call rather than the frontend
# ever holding a permanent TURN password. Leave TURN_SERVER_HOST blank
# to run with STUN only (works fine for officers on the same WiFi; calls
# between two officers both on cellular data may fail to connect without
# TURN configured).
TURN_SERVER_HOST=
TURN_SECRET=c07360541335253afa0f54e8d4333707bd002eed0756a435764e4c054f6dad3e
TURN_CREDENTIAL_TTL_SECONDS=3600

# Push / SMS notifications (future)
PUSH_NOTIFICATION_KEY=

# Offline sync (CLAUDE.md §25): ECDSA P-256 keypair used to sign the
# invitation manifest gate devices cache in IndexedDB, so a device can
# detect if its local cache was tampered with while offline. Generate
# with:
#   openssl ecparam -name prime256v1 -genkey -noout -out offline_private.pem
#   openssl ec -in offline_private.pem -pubout -out offline_public.pem
#   base64 -w0 offline_private.pem   # -> OFFLINE_SIGNING_PRIVATE_KEY_B64
#   base64 -w0 offline_public.pem    # -> OFFLINE_SIGNING_PUBLIC_KEY_B64
# The private key must never reach a client; the public key is served to
# gate devices by GET /offline-sync/manifest and is safe to publish.
OFFLINE_SIGNING_PRIVATE_KEY_B64=
OFFLINE_SIGNING_PUBLIC_KEY_B64=
