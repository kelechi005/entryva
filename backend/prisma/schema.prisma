// Estate Visitor Verification Platform — Prisma schema
// Derived from CLAUDE.md section 7 (Database Model).
// Every estate-owned table carries an explicit estateId for tenant isolation.
// Enforce estateId filtering in the service layer — never rely on the
// frontend, and never assume a record ID alone is sufficient authorization.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN
  ESTATE_ADMIN
  RESIDENT
  SECURITY_OFFICER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
  // Set when an admin removes a resident/security officer. Deliberately
  // not a real delete: their historical invitations, verification
  // events, and entry/exit records must survive (see Invitation.resident
  // onDelete: Cascade — actually deleting the User/ResidentProfile row
  // would wipe that history). REMOVED blocks login exactly like
  // SUSPENDED (AuthService.login / JwtStrategy.validate both check
  // status !== 'ACTIVE') and removed accounts are excluded from the
  // default admin list views.
  REMOVED
}

enum EstateStatus {
  ACTIVE
  SUSPENDED
}

// Lifecycle of a self-service estate signup (see SignupService). A row
// exists only between "form submitted" and "email verified" — no Estate
// or User is created until VERIFIED, so an abandoned/fake signup leaves
// nothing behind but an expiring row.
enum PendingSignupStatus {
  PENDING
  VERIFIED
  EXPIRED
  SUPERSEDED
}

enum ApartmentStatus {
  OCCUPIED
  VACANT
}

enum InvitationStatus {
  PENDING
  ACTIVE
  USED
  EXPIRED
  REVOKED
  CANCELLED
}

enum ResidentInviteStatus {
  PENDING
  USED
  EXPIRED
  REVOKED
}

enum EntryPolicy {
  ONE_TIME
  MULTI_ENTRY
}

enum EntryExitType {
  ENTRY
  EXIT
}

enum VerificationOutcome {
  VALID
  EXPIRED
  NOT_YET_VALID
  REVOKED
  ALREADY_USED
  WRONG_ESTATE
  NOT_FOUND
  RATE_LIMITED
}

// ---------------------------------------------------------------------------
// Platform / identity
// ---------------------------------------------------------------------------

model User {
  id               String     @id @default(cuid())
  email            String?    @unique
  phone            String?    @unique
  passwordHash     String?
  // Set for self-signup estate admins (their own name). Residents and
  // officers keep their names on their profile rows.
  displayName      String?
  externalAuthId   String?    @unique
  role             UserRole
  status           UserStatus @default(ACTIVE)
  // Hash of the current refresh token, so a stolen refresh token can be
  // invalidated (rotate-on-use) without maintaining a separate session table.
  refreshTokenHash String?
  // Only set (and only meaningful) when role === ESTATE_ADMIN. SUPER_ADMIN
  // is intentionally estate-less — it manages the platform, not one estate.
  adminEstateId    String?
  adminEstate      Estate?    @relation(fields: [adminEstateId], references: [id], onDelete: SetNull)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  lastLoginAt      DateTime?

  residentProfile        ResidentProfile?
  securityOfficerProfile SecurityOfficerProfile?
  auditLogs               AuditLog[]
  residentInvitesSent     ResidentInvite[]
  messagesSent            OfficerMessage[] @relation("OfficerMessagesSent")
  messagesReceived        OfficerMessage[] @relation("OfficerMessagesReceived")

  @@index([role])
}

model Estate {
  // --- Location & navigation (see EstateLocationService) ---
  // The estate pin and the main gate are deliberately separate points:
  // visitors are routed to the gate, never to the estate centre. No
  // Gate table (CLAUDE.md section 7) - one main entrance, stored here.
  latitude             Float?
  longitude            Float?
  mainGateName         String?
  mainGateLatitude     Float?
  mainGateLongitude    Float?
  entranceInstructions String?
  arrivalRadiusMeters  Int     @default(100)

  // Pass extension rules (see InvitationExtensionsService). Set per estate.
  passExtensionsEnabled Boolean @default(true)
  passExtendMaxMinutes  Int     @default(120)
  passMaxTotalMinutes   Int     @default(720)
  // Quiet hours, in minutes after local midnight (22:00 = 1320). Both null = off.
  passQuietFromMinute   Int?
  passQuietToMinute     Int?
  id        String       @id @default(cuid())
  name      String
  address   String?
  city      String?
  state     String?
  country   String?
  // Public-facing contact for the estate office (not the admin's login).
  contactPhone String?
  logoUrl   String?
  timezone  String       @default("UTC")
  status    EstateStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  buildings        Building[]
  apartments       Apartment[]
  residents        ResidentProfile[]
  securityOfficers SecurityOfficerProfile[]
  visitors         Visitor[]
  invitations      Invitation[]
  residentInvites  ResidentInvite[]
  auditLogs        AuditLog[]
  admins           User[]
  officerMessages  OfficerMessage[]
}

// ---------------------------------------------------------------------------
// Self-service signup
// ---------------------------------------------------------------------------

model PendingSignup {
  id           String              @id @default(cuid())
  email        String
  // Never store the raw token — only its SHA-256 (same rule as
  // ResidentInvite.tokenHash). Unique so a collision can never resolve
  // to the wrong signup.
  tokenHash    String              @unique
  // bcrypt hash chosen at signup; the plaintext password is never stored.
  passwordHash String
  adminName    String
  adminPhone   String?
  estateName   String
  address      String
  city         String
  state        String
  country      String
  timezone     String
  contactPhone String?
  status       PendingSignupStatus @default(PENDING)
  expiresAt    DateTime
  verifiedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([email, status])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Estate structure
// ---------------------------------------------------------------------------

model Building {
  id        String   @id @default(cuid())
  estateId  String
  estate    Estate   @relation(fields: [estateId], references: [id], onDelete: Cascade)
  name      String
  code      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  apartments Apartment[]

  @@index([estateId])
  // Exact-match, case-sensitive backstop against a create/create race
  // slipping past the app-level check in AdministrationService
  // (assertBuildingNameIsFree, which is case-insensitive and trimmed —
  // the real duplicate rule lives there, this index only guarantees the
  // DB itself never ends up with two byte-identical names).
  @@unique([estateId, name])
}

model Apartment {
  id         String          @id @default(cuid())
  estateId   String
  estate     Estate          @relation(fields: [estateId], references: [id], onDelete: Cascade)
  buildingId String
  building   Building        @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  // Treated as opaque data, not a numeric value: "B-204", "Flat 4", etc.
  flatNumber String
  status     ApartmentStatus @default(VACANT)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  residents   ResidentProfile[]
  invitations Invitation[]
  residentInvites ResidentInvite[]

  @@index([estateId])
  @@index([buildingId])
  @@unique([buildingId, flatNumber])
}

model ResidentProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  estateId    String
  estate      Estate   @relation(fields: [estateId], references: [id], onDelete: Cascade)
  apartmentId String
  apartment   Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  displayName String
  phone       String?
  status      UserStatus @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invitations Invitation[]

  @@index([estateId])
  @@index([apartmentId])
}

// Admin-initiated resident onboarding invite: admin picks the apartment
// + types the resident's email, we email a one-time link, the resident
// opens it and sets their own name + password. Never a real account
// until the link is used — see ResidentInvitesService for why the
// apartment binding has to be decided by the admin up front (identity
// can't be trusted from a self-filled form alone).
model ResidentInvite {
  id          String                @id @default(cuid())
  estateId    String
  estate      Estate                @relation(fields: [estateId], references: [id], onDelete: Cascade)
  apartmentId String
  apartment   Apartment             @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  email       String
  // Never store the raw token — same "shown once" rule as Invitation's
  // secureTokenHash. Unique so a hash collision can never silently
  // resolve to the wrong invite.
  tokenHash   String                @unique
  status      ResidentInviteStatus  @default(PENDING)
  expiresAt   DateTime
  invitedById String
  invitedBy   User                  @relation(fields: [invitedById], references: [id], onDelete: Cascade)
  usedAt      DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([estateId])
  @@index([apartmentId])
  @@index([tokenHash])
}

model SecurityOfficerProfile {
  id           String     @id @default(cuid())
  userId       String     @unique
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  estateId     String
  estate       Estate     @relation(fields: [estateId], references: [id], onDelete: Cascade)
  fullName     String
  employeeCode String
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  verificationEvents VerificationEvent[]
  entryExitEvents    EntryExitEvent[]

  @@index([estateId])
  @@unique([estateId, employeeCode])
}

// ---------------------------------------------------------------------------
// Visitors & invitations (core domain)
// ---------------------------------------------------------------------------

model Visitor {
  id        String   @id @default(cuid())
  estateId  String
  estate    Estate   @relation(fields: [estateId], references: [id], onDelete: Cascade)
  fullName  String
  phone     String?
  photoUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invitations Invitation[]

  @@index([estateId])
}

model Invitation {
  id              String           @id @default(cuid())
  estateId        String
  estate          Estate           @relation(fields: [estateId], references: [id], onDelete: Cascade)
  residentId      String
  resident        ResidentProfile  @relation(fields: [residentId], references: [id], onDelete: Cascade)
  apartmentId     String
  apartment       Apartment        @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  visitorId       String
  visitor         Visitor          @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  // Never store raw secrets. Only hashes are persisted; the plaintext
  // token/code is shown to the resident/visitor once at creation time.
  secureTokenHash String           @unique
  displayCodeHash String

  validFrom  DateTime
  validUntil DateTime
  status     InvitationStatus @default(PENDING)
  entryPolicy EntryPolicy     @default(ONE_TIME)
  visitorType VisitorType     @default(GUEST)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  revokedAt  DateTime?
  usedAt     DateTime?

  // Live arrival tracking. Only the LATEST point, shared by the visitor on
  // purpose; cleared on stop, arrival or expiry. Never a location history.
  liveLat       Float?
  liveLng       Float?
  liveHeading   Float?
  liveAccuracyM Float?
  liveUpdatedAt DateTime?
  liveArrivedAt DateTime?

  events             InvitationEvent[]
  verificationEvents VerificationEvent[]
  visits             Visit[]

  @@index([estateId])
  @@index([residentId])
  @@index([apartmentId])
  @@index([status])
}

// Append-only history of state transitions for an invitation
// (created, shared, viewed, revoked, expired, used, etc).
model InvitationEvent {
  id           String   @id @default(cuid())
  invitationId String
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  type         String
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([invitationId])
}

// A verification attempt at the gate — may succeed or fail, always logged.
model VerificationEvent {
  id                String              @id @default(cuid())
  invitationId      String?
  invitation        Invitation?         @relation(fields: [invitationId], references: [id], onDelete: SetNull)
  securityOfficerId String
  securityOfficer   SecurityOfficerProfile @relation(fields: [securityOfficerId], references: [id], onDelete: Cascade)
  outcome           VerificationOutcome
  method            String // "QR" | "MANUAL_CODE"
  offline           Boolean             @default(false)
  createdAt         DateTime            @default(now())

  @@index([invitationId])
  @@index([securityOfficerId])
}

// One realized visit tied to an invitation (start on entry, end on exit).
model Visit {
  id           String    @id @default(cuid())
  invitationId String
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  enteredAt    DateTime?
  exitedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  entryExitEvents EntryExitEvent[]

  @@index([invitationId])
}

model EntryExitEvent {
  id                String        @id @default(cuid())
  visitId           String
  visit             Visit         @relation(fields: [visitId], references: [id], onDelete: Cascade)
  securityOfficerId String
  securityOfficer   SecurityOfficerProfile @relation(fields: [securityOfficerId], references: [id], onDelete: Cascade)
  type              EntryExitType
  createdAt         DateTime      @default(now())

  @@index([visitId])
}

// ---------------------------------------------------------------------------
// Supporting domain
// ---------------------------------------------------------------------------

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  payload   Json?
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  estateId  String?
  estate    Estate?  @relation(fields: [estateId], references: [id], onDelete: SetNull)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String?
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([estateId])
  @@index([userId])
}

enum OfflineSyncStatus {
  SYNCED
  FAILED
}

// CLAUDE.md §26: append-only record of what an offline gate device
// eventually reported. clientEventId is the idempotency key — a retried
// sync of the same event must resolve to the same row, never a duplicate
// EntryExitEvent/Visit. occurredAt (device clock, while offline) is kept
// distinct from syncedAt (server clock, when the batch was processed) so
// "ordered where necessary" can be reconstructed after the fact.
model OfflineSyncEvent {
  id                String            @id @default(cuid())
  estateId          String
  securityOfficerId String
  deviceId          String
  eventType         String // "ENTRY" | "DENY"
  payload           Json
  status            OfflineSyncStatus @default(SYNCED)
  errorMessage      String?
  clientEventId     String            @unique // idempotency key from the offline client
  occurredAt        DateTime
  syncedAt          DateTime          @default(now())

  @@index([deviceId])
  @@index([estateId])
  @@index([securityOfficerId])
}

// ---------------------------------------------------------------------------
// Officer-to-officer intercom: direct messages, alongside the WebRTC calls
// (see CallsGateway). Deliberately its own model rather than reusing
// Notification -- a Notification is one-directional (system -> user) and
// has no concept of a conversation thread or a sender; a message thread
// needs both parties queryable efficiently in either direction (see the
// two indexes below), which Notification's shape doesn't support without
// contorting it.
model OfficerMessage {
  id         String    @id @default(cuid())
  estateId   String
  estate     Estate    @relation(fields: [estateId], references: [id], onDelete: Cascade)
  fromUserId String
  fromUser   User      @relation("OfficerMessagesSent", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User      @relation("OfficerMessagesReceived", fields: [toUserId], references: [id], onDelete: Cascade)
  body       String
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  // Covers "history with officer X, newest first" from either side of the
  // conversation (a->b and b->a are two distinct rows, never merged, so
  // both directions need their own lookup path).
  @@index([estateId, fromUserId, toUserId, createdAt])
  @@index([estateId, toUserId, fromUserId, createdAt])
  // Unread-count-per-sender lookups (toUserId, readAt IS NULL, grouped by
  // fromUserId) for the officer list screen.
  @@index([estateId, toUserId, readAt])
}


// ---- Recurring passes (house help, drivers, cleaners, regular deliveries) ----
// Owner/estate/unit are plain ids for now; foreign keys to the existing
// tables are added once the API is wired up.

enum RecurringPassStatus {
  ACTIVE
  PAUSED
  REVOKED
  EXPIRED
}

enum RecurringPassRole {
  HOUSE_HELP
  DRIVER
  CLEANER
  DELIVERY
  OTHER
}

enum RecurringPassExceptionType {
  SKIP
  EXTRA
}

enum RecurringScanDirection {
  IN
  OUT
}

enum RecurringScanResult {
  ALLOWED
  DENIED
}

model RecurringPass {
  id          String            @id @default(cuid())
  estateId    String
  residentId  String
  apartmentId String

  fullName String
  phone    String?
  role     RecurringPassRole
  photoUrl String?

  // Allowed weekdays (0 = Sunday ... 6 = Saturday) and the daily window, in
  // minutes after local midnight (09:00 = 540). All in the estate's time zone.
  days        Int[]
  startMinute Int
  endMinute   Int

  validFrom    DateTime @db.Date
  validUntil   DateTime @db.Date
  graceMinutes Int      @default(30)

  status RecurringPassStatus @default(ACTIVE)

  // Only the hash of the secret link token is stored.
  tokenHash String @unique

  // First phone that opened the pass (a hash of a random id kept on that phone).
  linkedDeviceHash String?
  linkedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exceptions RecurringPassException[]
  scans      RecurringPassScan[]

  @@index([estateId, status])
  @@index([residentId])
  @@index([apartmentId, status])
}

model RecurringPassException {
  id     String                     @id @default(cuid())
  passId String
  pass   RecurringPass              @relation(fields: [passId], references: [id], onDelete: Cascade)
  date   DateTime                   @db.Date
  type   RecurringPassExceptionType

  // For EXTRA days only: optional custom hours (minutes after local midnight).
  startMinute Int?
  endMinute   Int?

  createdAt DateTime @default(now())

  @@unique([passId, date])
}

// One row per scan. Append-only: the database rejects UPDATE and DELETE.
model RecurringPassScan {
  id            String                  @id @default(cuid())
  passId        String
  pass          RecurringPass           @relation(fields: [passId], references: [id], onDelete: Restrict)
  officerUserId String?
  scannedAt     DateTime                @default(now())
  direction     RecurringScanDirection?
  result        RecurringScanResult
  reason        String?

  @@index([passId, scannedAt])
}

model EstateBlockedPerson {
  id        String   @id @default(cuid())
  estateId  String
  phone     String
  fullName  String?
  reason    String?
  createdAt DateTime @default(now())

  @@unique([estateId, phone])
  @@index([estateId])
}


enum VisitorType {
  GUEST
  COURIER
}

// ---------------------------------------------------------------------------
// Push notifications, estate announcements, emergency alerts
// (CLAUDE.md 7.2). Like `Notification`, these hold plain ids instead of
// relations: they are append-mostly operational records, and keeping them
// off the User/Estate models means adding them never touches those tables.
// ---------------------------------------------------------------------------

enum AnnouncementKind {
  ANNOUNCEMENT
  SECURITY_ALERT
}

enum EmergencyKind {
  FIRE
  MEDICAL
  SECURITY
  OTHER
}

enum EmergencyStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

// One row per browser/phone that agreed to receive push messages. The
// endpoint is the push service's private address for that device, so it is
// unique, and a device that signs in as someone else simply moves to them.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// Estate-wide notices written by the admin, and urgent security alerts
// that the admin or a security officer can send to everyone in the estate.
// The author's name is copied in so the notice still reads correctly if
// that account is later renamed or removed.
model Announcement {
  id         String           @id @default(cuid())
  estateId   String
  authorId   String
  authorName String
  kind       AnnouncementKind
  title      String
  body       String
  createdAt  DateTime         @default(now())

  @@index([estateId, createdAt])
  @@index([estateId, kind, createdAt])
}

// A resident pressing the emergency button. Security officers (and the
// admin) are told; an officer acknowledges and later resolves it. Names
// and the apartment label are copied in so the record stays readable.
model EmergencyAlert {
  id                 String          @id @default(cuid())
  estateId           String
  raisedById         String
  raisedByName       String
  apartmentLabel     String
  kind               EmergencyKind
  note               String?
  status             EmergencyStatus @default(OPEN)
  acknowledgedById   String?
  acknowledgedByName String?
  acknowledgedAt     DateTime?
  resolvedById       String?
  resolvedByName     String?
  resolvedAt         DateTime?
  createdAt          DateTime        @default(now())

  @@index([estateId, status, createdAt])
  @@index([raisedById, createdAt])
}
