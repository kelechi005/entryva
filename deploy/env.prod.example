# Copy this to .env in the SAME directory as docker-compose.prod.yml on
# the server (docker compose reads a .env file from its own directory
# automatically — no --env-file flag needed). This is what the compose
# file itself reads; it's separate from backend.env, which is what the
# backend *container* reads.

# From deploy/generate-secrets.sh.
POSTGRES_PASSWORD=

# Must already resolve to this server (an A record at your DNS
# provider) before the caddy service starts, or it can't get a Let's
# Encrypt certificate.
DOMAIN=yourdomain.example.com

# The CD workflow (.github/workflows/ci.yml) exports these automatically
# on every deploy — you only need to set them here for a manual, one-off
# `docker compose -f docker-compose.prod.yml up -d` (e.g. the very first
# deploy, before you've pushed to main, or debugging on the server
# directly). Replace OWNER/REPO with your GitHub org/repo, lowercased.
BACKEND_IMAGE=ghcr.io/owner/repo-backend:latest
FRONTEND_IMAGE=ghcr.io/owner/repo-frontend:latest
