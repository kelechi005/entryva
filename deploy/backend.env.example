# Copy this to backend.env next to docker-compose.prod.yml on the server
# and fill it in. Generate AUTH_SECRET / AUTH_REFRESH_SECRET /
# OFFLINE_SIGNING_*_KEY_B64 with deploy/generate-secrets.sh — don't reuse
# the values from backend/.env (those are for local dev only).
#
# DATABASE_URL is deliberately NOT set here — docker-compose.prod.yml's
# `backend` service overrides it with the postgres service's hostname and
# the POSTGRES_PASSWORD from the top-level .env, so it isn't duplicated
# into two files that could drift out of sync.

NODE_ENV=production
PORT=4000
LOG_LEVEL=info

AUTH_SECRET=
AUTH_REFRESH_SECRET=
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=7d

# Same domain as DOMAIN in the top-level .env, with the scheme — Caddy
# proxies both the frontend and /api/* from that one origin (see
# Caddyfile), so this is the only origin that ever needs to be trusted.
CORS_ORIGINS=https://yourdomain.example.com
FRONTEND_ORIGIN=https://yourdomain.example.com
# Caddy sits in front of this container and is the thing actually
# terminating TLS/talking to the internet — trust its X-Forwarded-* headers.
TRUST_PROXY=true

OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# See backend/.env.example for the full explanation. Leaving these blank
# means resident invite emails are only logged, never actually sent —
# fine for a first smoke-test deploy, not fine to leave that way.
RESEND_API_KEY=
EMAIL_FROM=

# See coturn/README.md. Leave blank to run STUN-only (fine unless two
# officers are both on cellular data during a call).
TURN_SERVER_HOST=turn.entryva.tect
TURN_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=3600

PUSH_NOTIFICATION_KEY=

OFFLINE_SIGNING_PRIVATE_KEY_B64=
OFFLINE_SIGNING_PUBLIC_KEY_B64=
